---
import Base from "@layouts/Base.astro";
import Button from "@components/Button.astro";
import { aboutList, services, teachingList } from "@utils/data";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import heroImg from "@assets/heroImg.png";
import teachingImg from "@assets/teachingImg.png";
import halftoneBg from "@assets/halftoneBg.png";
import aboutPhoto from "@assets/aboutPhoto.jpg";
import { sanityClient } from "sanity:client";
import SanityImage from "@components/SanityImage.astro";
const projects = await sanityClient.fetch(
    `*[_type == "project"] | order(date desc)`,
);
import { isNew } from "@utils/index";
import ProjectGallery from "@components/ProjectGallery.astro";
---

<Base>
    <section
        id="hero"
        class="dark flex relative overflow-clip bg-surface lg:h-svh"
    >
        <div class="z-10 aspect-3/4 lg:aspect-auto flex flex-col lg:flex-1">
            <div class="text-center lg:text-left text-strong grow flex flex-col justify-center lg:justify-start gap-4 lg:max-w-3xl px-site py-24">
                <h1 class="heading text-dh1">
                    Profesjonalne malowanie I oznakowanie nawierzchni
                </h1>
                <p class="text-lg/6 text-body text-pretty">
                    Zajmujemy się wykonywaniem oznakowania poziomego oraz
                    malowaniem nawierzchni na parkingach, drogach, placach i
                    terenach przemysłowych.
                </p>
            </div>
            <div class="flex *:w-full divide-x divide-surface border-t border-b border-surface">
                <Button size="lg" href={"#footer"}>
                    Wyślij zapytanie
                </Button>
                <Button intent="secondary" size="lg" href={"#about"}>
                    O nas
                </Button>
            </div>
        </div>
        <Image
            class="bg-surface absolute inset-x-0 bottom-0 aspect-3/4 lg:static lg:h-full lg:w-auto lg:max-w-none lg:shrink-0 object-cover"
            src={heroImg}
            alt=""
            loading="eager"
        />
        <div class="bg-radial from-surface/25 to-surface/0 absolute inset-x-0 top-1/2 -translate-y-1/2 aspect-square lg:hidden pointer-events-none" />
    </section>
    <section
        id="about"
        class="px-site flex flex-col gap-6 lg:grid lg:grid-cols-12"
    >
        <div class="flex flex-col gap-4 lg:col-span-6">
            <h2 class="heading text-3xl">O nas</h2>
            <div class="*:text-pretty *:not-first:mt-2">
                <p>
                    Rudline to dynamicznie rozwijająca się firma, która od ponad
                    5 lat z powodzeniem realizuje projekty na terenie całej
                    Polski i Ukrainy. Specjalizujemy się w profesjonalnym
                    oznakowaniu dróg, parkingów, terenów przemysłowych i
                    przestrzeni użytkowych.
                </p>
                <p>
                    Łączymy doświadczenie, nowoczesne technologie oraz wysoką
                    jakość wykonania, aby tworzyć rozwiązania trwałe i
                    dopasowane do potrzeb naszych klientów. Każdy projekt
                    realizujemy z dbałością o szczegóły, terminowość i
                    bezpieczeństwo. Stale się rozwijamy, poszerzamy zakres usług
                    i podążamy za nowoczesnymi standardami branży. Naszym celem
                    jest nie tylko wykonanie zlecenia, ale przede wszystkim
                    stworzenie rozwiązania, które sprawdzi się przez lata.
                </p>
            </div>
            <ul class="*:flex *:items-center flex flex-wrap *:grow-0 gap-x-4 gap-y-3">
                {aboutList.map((item) => (
                    <li class="flex gap-2 items-center">
                        <Icon name="griddy-icons:check-circle-alt-01" />
                        <span>{item}</span>
                    </li>
                ))}
            </ul>
        </div>
        <Image
            class="aspect-4/3 w-full lg:col-start-8 lg:col-span-5 border border-accent/25"
            src={aboutPhoto}
            alt=""
        />
    </section>
    <section
        id="projects"
        class="px-4 xl:px-12 flex flex-col gap-6 dark bg-surface pt-8 pb-5 mt-4 scheme-dark"
    >
        <div class="flex flex-col gap-4">
            <h2 class="heading text-3xl text-strong">Najnowsze projekty</h2>
            <p class="text-body">
                Wybrane realizacje z ostatnich miesięcy: przejścia dla pieszych,
                miejsca postojowe i oznakowanie dróg.
            </p>
        </div>
        <ProjectGallery {projects} />
    </section>
    <section id="services" class="px-4 xl:px-12 flex flex-col gap-6">
        <div class="flex flex-col gap-4">
            <h2 class="heading text-3xl xl:text-4xl">Usługi</h2>
            <p>
                Od parkingów po drogi publiczne: oznakowanie poziome i pionowe
                dla firm, instytucji i zarządców terenów.
            </p>
        </div>
        <div
            id="services-grid"
            class="grid gap-3 md:grid-cols-2 lg:grid-cols-3"
        >
            {services.map((s, i) => (
                <div
                    data-extra={i >= 6 ? "" : undefined}
                    hidden={i >= 6}
                    class="flex flex-col justify-between gap-4 p-4 border border-accent/20 bg-accent/5 relative overflow-clip"
                >
                    <h3 class="text-xl/6 font-medium">{s.title}</h3>
                    <p>{s.description}</p>
                    <Image
                        class="absolute inset-0 -z-10 opacity-10"
                        src={halftoneBg}
                        alt=""
                    />
                </div>
            ))}
            <Button
                id="services-toggle"
                intent="secondary"
                type="button"
                aria-expanded="false"
                aria-controls="services-grid"
                class="justify-self-end col-span-full cursor-pointer"
            >
                Pokaż wszystkie
            </Button>
        </div>
    </section>
    <section
        id="teaching"
        class="px-site flex flex-col gap-6 lg:grid lg:grid-cols-12"
    >
        <div class="flex flex-col gap-8 lg:col-span-6">
            <div class="flex flex-col gap-4">
                <h2 class="heading text-3xl xl:text-4xl">Uczymy i wspieramy</h2>
                <Image
                    class="aspect-square lg:hidden"
                    src={teachingImg}
                    alt=""
                />
                <p>
                    Dobre oznakowanie działa tylko wtedy, gdy kierowcy i piesi
                    rozumieją, jak z niego korzystać. Pomagamy zarządcom
                    parkingów i obiektów dobrać rozwiązania czytelne, trwałe i
                    zgodne z obowiązującymi przepisami.
                </p>
                <ul class="flex flex-col gap-y-3">
                    {teachingList.map((item) => (
                        <li class="flex gap-2 items-center">
                            <Icon name="griddy-icons:check-circle-alt-01" />
                            <span>{item}</span>
                        </li>
                    ))}
                </ul>
            </div>
            <Button href="#footer">Zapytaj o doradztwo</Button>
        </div>
        <Image
            class="aspect-square hidden lg:block lg:col-start-8 lg:col-span-5"
            src={teachingImg}
            alt=""
        />
    </section>
</Base>

<script>
    const btn = document.getElementById("services-toggle");
    const extras = document.querySelectorAll("[data-extra]");

    btn?.addEventListener("click", () => {
        const open = btn.getAttribute("aria-expanded") === "true";
        extras.forEach((el) => el.toggleAttribute("hidden", open));
        btn.setAttribute("aria-expanded", String(!open));
        btn.textContent = open ? "Pokaż wszystkie" : "Ukryj";
    });
</script>
