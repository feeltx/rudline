---
import Logo from "@components/Logo.astro";
import { contactData } from "@utils/data";
---

<header class="flex justify-between px-site py-1 bg-surface items-center fixed inset-x-0 top-0 z-50">
    <a href="#hero" aria-label="wróć na górę strony`">
        <Logo classes="h-4.5" />
    </a>
    <span class="text-base py-2.5">{contactData[0].contacts.phone.value}</span>
</header>
